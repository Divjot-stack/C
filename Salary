#include <stdio.h>

int main() {
    float basic, da, hra, gross;

    // Input basic salary
    printf("Enter basic salary: ");
    scanf("%f", &basic);

    // Calculate allowances
    da = 0.40 * basic;
    hra = 0.20 * basic;

    // Calculate gross salary
    gross = basic + da + hra;

    // Display result
    printf("Gross Salary = %.2f\n", gross);

    return 0;
}
